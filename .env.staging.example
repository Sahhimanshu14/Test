# ==============================================================================
# CDSPrep Staging & Pre-Production Environment Profile (.env.staging.example)
# Test real external integrations against provider sandboxes before production
# ==============================================================================

NODE_ENV=staging
PORT=4000
WEB_PORT=3000
WORKER_CONCURRENCY=5

# 1. DATABASE (Managed Staging PostgreSQL)
DATABASE_URL="postgresql://staging_user:STAGING_STRONG_PASSWORD@staging-db.cdsprep.com:5432/cdsprep_staging?sslmode=require"
DATABASE_DIRECT_URL="postgresql://staging_user:STAGING_STRONG_PASSWORD@staging-db.cdsprep.com:5432/cdsprep_staging"
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT_MS=10000
DATABASE_SSL=true

# 2. REDIS (Managed Staging Redis with TLS)
REDIS_URL="rediss://default:STAGING_REDIS_PASSWORD@staging-redis.cdsprep.com:6380"
REDIS_HOST="staging-redis.cdsprep.com"
REDIS_PORT=6380
REDIS_PASSWORD="STAGING_REDIS_PASSWORD"
REDIS_TLS=true

# 3. AUTHENTICATION & SECRETS (Rotate every 90 days)
JWT_ACCESS_SECRET="generate_with_openssl_rand_hex_64_min_32_characters"
JWT_REFRESH_SECRET="generate_with_openssl_rand_hex_64_min_32_characters"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
COOKIE_DOMAIN="staging.cdsprep.com"
COOKIE_SECURE=true

# 4. CORS & CLIENT APPS (Strict staging origins, NO wildcard)
CORS_ORIGIN="https://staging.cdsprep.com"
NEXT_PUBLIC_APP_URL="https://staging.cdsprep.com"
NEXT_PUBLIC_API_URL="https://staging-api.cdsprep.com/api/v1"

# 5. AI PROVIDER (Staging OpenAI Sandbox or Low Tier)
ENABLE_AI=true
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY="sk-proj-STAGING_OPENAI_TEST_KEY"
AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=15000
AI_DAILY_USER_LIMIT=50
AI_MONTHLY_USER_LIMIT=500

# 6. TRANSACTIONAL EMAIL (Resend Test/Staging Domain)
ENABLE_EMAIL=true
EMAIL_PROVIDER=resend
EMAIL_API_KEY="re_staging_api_key_here"
EMAIL_FROM="CDSPrep Staging <notifications@staging.cdsprep.com>"

# 7. CLOUD OBJECT STORAGE (Cloudflare R2 or S3 Staging Bucket)
ENABLE_STORAGE=true
STORAGE_PROVIDER=r2
S3_BUCKET="cdsprep-staging-assets"
S3_REGION="auto"
S3_ENDPOINT="https://<cloudflare_account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="STAGING_R2_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="STAGING_R2_SECRET_KEY"
S3_PUBLIC_CDN_URL="https://staging-assets.cdsprep.com"
MAX_UPLOAD_SIZE_BYTES=15728640

# 8. PAYMENT GATEWAY (Razorpay Test Mode Credentials)
ENABLE_PAYMENTS=true
PAYMENT_PROVIDER=razorpay
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID="rzp_test_STAGING_KEY_ID"
RAZORPAY_KEY_SECRET="STAGING_RAZORPAY_SECRET"
RAZORPAY_WEBHOOK_SECRET="STAGING_WEBHOOK_SECRET"

# 9. SEARCH ENGINE
SEARCH_PROVIDER=postgres
SEARCH_PAGE_SIZE=20

# 10. ERROR MONITORING (Sentry Staging Environment)
SENTRY_DSN="https://sample_sentry_key@o0.ingest.sentry.io/0000000"
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=cdsprep-staging@0.1.0

# 11. BOT PROTECTION & OAUTH
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY="1x0000000000000000000000000000000AA"
GOOGLE_CLIENT_ID="staging-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="staging-google-secret"
