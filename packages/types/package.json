{
  "name": "@cdsprep/types",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "echo \"@cdsprep/types linted\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@cdsprep/types test passed\""
  },
  "devDependencies": {
    "@cdsprep/config": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
