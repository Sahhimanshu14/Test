# ==============================================================================
# CDSPrep Master Production Environment Blueprint (.env.example)
#
# CRITICAL SECURITY DIRECTIVES:
# 1. NEVER commit this file with real credentials to Git or public repositories.
# 2. In production, load secrets via HashiCorp Vault, AWS Secrets Manager, or
#    Kubernetes Sealed Secrets.
# 3. All secrets MUST meet minimum entropy requirements (>= 32 chars).
# 4. NEVER prefix backend secrets with NEXT_PUBLIC_* (leaks to browser).
# 5. Wildcard CORS origins (*) are STRICTLY PROHIBITED in production mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CORE
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
WEB_PORT=3000
WORKER_CONCURRENCY=10

# ------------------------------------------------------------------------------
# 2. DATABASE (Managed PostgreSQL with Connection Pooling & TLS)
# ------------------------------------------------------------------------------
# PgBouncer / Supabase Pooler transaction connection string (Port 6543 or 5432)
DATABASE_URL="postgresql://prod_app_user:STRONG_PRODUCTION_DB_PASSWORD@db.cdsprep.internal:5432/cdsprep?sslmode=require&pool_timeout=10"
# Direct connection string for Prisma migrations & schema changes
DATABASE_DIRECT_URL="postgresql://prod_app_user:STRONG_PRODUCTION_DB_PASSWORD@db.cdsprep.internal:5432/cdsprep?sslmode=require"
DATABASE_POOL_SIZE=30
DATABASE_TIMEOUT_MS=10000
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 3. CACHE & MESSAGE BROKER (Redis with TLS & AUTH)
# ------------------------------------------------------------------------------
REDIS_URL="rediss://default:STRONG_REDIS_PASSWORD@redis.cdsprep.internal:6380"
REDIS_HOST="redis.cdsprep.internal"
REDIS_PORT=6380
REDIS_PASSWORD="STRONG_REDIS_PASSWORD"
REDIS_TLS=true

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & CRYPTOGRAPHY (JWT & Argon2id)
# Generate with: openssl rand -hex 64
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="GENERATE_64_BYTE_RANDOM_HEX_FOR_ACCESS_TOKENS_MIN_32_CHARS"
JWT_REFRESH_SECRET="GENERATE_64_BYTE_RANDOM_HEX_FOR_REFRESH_TOKENS_MIN_32_CHARS"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
COOKIE_DOMAIN=".cdsprep.com"
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 5. FRONTEND & CORS POLICY
# Wildcards are strictly rejected at startup in production mode.
# ------------------------------------------------------------------------------
CORS_ORIGIN="https://cdsprep.com,https://app.cdsprep.com"
NEXT_PUBLIC_APP_URL="https://cdsprep.com"
NEXT_PUBLIC_API_URL="https://api.cdsprep.com/api/v1"

# ------------------------------------------------------------------------------
# 6. AI CONCEPTUAL TUTOR (OpenAI, Google Gemini, or Anthropic)
# ------------------------------------------------------------------------------
ENABLE_AI=true
AI_PROVIDER="openai" # Options: openai, google, anthropic, mock
AI_MODEL="gpt-4o-mini"
OPENAI_API_KEY="sk-proj-YOUR_PRODUCTION_OPENAI_API_KEY"
GOOGLE_AI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=15000
AI_DAILY_USER_LIMIT=50
AI_MONTHLY_USER_LIMIT=500

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL SERVICE (Resend or SendGrid)
# ------------------------------------------------------------------------------
ENABLE_EMAIL=true
EMAIL_PROVIDER="resend" # Options: resend, sendgrid, mock
EMAIL_API_KEY="re_YOUR_PRODUCTION_RESEND_API_KEY"
EMAIL_FROM="CDSPrep Admissions <notifications@cdsprep.com>"

# ------------------------------------------------------------------------------
# 8. CLOUD OBJECT STORAGE (AWS S3, Cloudflare R2, MinIO, or Supabase)
# ------------------------------------------------------------------------------
ENABLE_STORAGE=true
STORAGE_PROVIDER="r2" # Options: s3, r2, supabase, minio, local
S3_BUCKET="cdsprep-production-assets"
S3_REGION="auto"
S3_ENDPOINT="https://<cloudflare_account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="YOUR_PRODUCTION_R2_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="YOUR_PRODUCTION_R2_SECRET_ACCESS_KEY"
S3_PUBLIC_CDN_URL="https://assets.cdsprep.com"
MAX_UPLOAD_SIZE_BYTES=15728640 # 15MB

# ------------------------------------------------------------------------------
# 9. PAYMENT GATEWAY & WEBHOOKS (Razorpay / Stripe)
# ------------------------------------------------------------------------------
ENABLE_PAYMENTS=true
PAYMENT_PROVIDER="razorpay" # Options: razorpay, stripe, mock
PAYMENT_CURRENCY="INR"
RAZORPAY_KEY_ID="rzp_live_YOUR_PRODUCTION_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_PRODUCTION_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_PRODUCTION_WEBHOOK_SECRET"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 10. SEARCH ENGINE (PostgreSQL Full-Text Search or OpenSearch)
# ------------------------------------------------------------------------------
SEARCH_PROVIDER="postgres" # Options: postgres, opensearch, mock
SEARCH_PAGE_SIZE=20

# ------------------------------------------------------------------------------
# 11. APPLICATION MONITORING & OBSERVABILITY (Sentry)
# ------------------------------------------------------------------------------
SENTRY_DSN="https://your_sentry_dsn_key@o0.ingest.sentry.io/0000000"
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE="cdsprep@1.0.0"
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------------------------------
# 12. BOT DEFENSE & SOCIAL OAUTH
# ------------------------------------------------------------------------------
CAPTCHA_PROVIDER="turnstile" # Options: turnstile, recaptcha, none
CAPTCHA_SECRET_KEY="YOUR_CLOUDFLARE_TURNSTILE_SECRET_KEY"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
