# ==============================================================================
# CDSPrep Web Application Environment Configuration Template
# ==============================================================================
# NOTICE: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# NEVER place database credentials, secret keys, or private tokens in this file.

# ------------------------------------------------------------------------------
# 1. PUBLIC ENVIRONMENT VARIABLES (Exposed to Browser)
# ------------------------------------------------------------------------------

# The public canonical URL of the web frontend application
NEXT_PUBLIC_APP_URL="https://cdsprep.your-domain"

# The public production REST API base endpoint (must point to your deployed API)
NEXT_PUBLIC_API_URL="https://api.your-domain/api/v1"

# Optional: Cloudflare Turnstile or Google reCAPTCHA site key for bot defense
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""

# Optional: Product analytics telemetry key (e.g. PostHog public key)
NEXT_PUBLIC_POSTHOG_KEY=""

# Optional: Product analytics ingestion host
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY ENVIRONMENT VARIABLES (Next.js Node.js Runtime Only)
# ------------------------------------------------------------------------------

# Application runtime environment ('development', 'test', 'staging', 'production')
NODE_ENV="production"
