# ==============================================================================
# CDSPrep Local Development Environment Profile (.env.development.example)
# Copy to .env for local full-stack development
# ==============================================================================

NODE_ENV=development
PORT=4000
WEB_PORT=3000
WORKER_CONCURRENCY=3

# 1. DATABASE (PostgreSQL local container)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cdsprep?schema=public&connection_limit=15&pool_timeout=10"
DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cdsprep?schema=public"
DATABASE_POOL_SIZE=15
DATABASE_TIMEOUT_MS=10000
DATABASE_SSL=false

# 2. REDIS (Cache & BullMQ queues)
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# 3. AUTHENTICATION (Dev secrets >= 32 characters)
JWT_ACCESS_SECRET="cdsprep_development_jwt_access_secret_min_32_characters"
JWT_REFRESH_SECRET="cdsprep_development_jwt_refresh_secret_min_32_characters"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# 4. CORS & CLIENT APPS
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# 5. AI TUTOR (Mock mode for local dev without spending API credits)
ENABLE_AI=true
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=15000
AI_DAILY_USER_LIMIT=50
AI_MONTHLY_USER_LIMIT=500
# Optional: Provide real API key to test live OpenAI or Gemini locally
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# 6. TRANSACTIONAL EMAIL (Mock mode captures emails in memory/logs)
ENABLE_EMAIL=true
EMAIL_PROVIDER=mock
EMAIL_FROM="CDSPrep Dev Support <notifications@cdsprep.local>"
EMAIL_API_KEY=

# 7. OBJECT STORAGE (Local filesystem mode)
ENABLE_STORAGE=false
STORAGE_PROVIDER=local
S3_BUCKET=cdsprep-assets
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_SIZE_BYTES=15728640

# 8. PAYMENT GATEWAY (Mock checkout mode)
ENABLE_PAYMENTS=true
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 9. SEARCH ENGINE (PostgreSQL Full-Text Search)
SEARCH_PROVIDER=postgres
SEARCH_PAGE_SIZE=20

# 10. ERROR MONITORING (Disabled in local dev)
SENTRY_DSN=

# 11. BOT PROTECTION & OAUTH
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
