# ==============================================================================
# CDSPrep Automated Testing Environment Profile (.env.test.example)
# Used during CI and local vitest test runs
# ==============================================================================

NODE_ENV=test
PORT=4001
WEB_PORT=3001
WORKER_CONCURRENCY=2

# 1. DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cdsprep_test?schema=public"
DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cdsprep_test?schema=public"
DATABASE_POOL_SIZE=5
DATABASE_TIMEOUT_MS=5000
DATABASE_SSL=false

# 2. REDIS
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# 3. AUTHENTICATION & SECRETS
JWT_ACCESS_SECRET="cdsprep_test_jwt_access_secret_32_characters_long"
JWT_REFRESH_SECRET="cdsprep_test_jwt_refresh_secret_32_characters_long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# 4. CORS & CLIENT APPS
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# 5. MOCK INTEGRATIONS (Never call external APIs in CI tests)
ENABLE_AI=true
AI_PROVIDER=mock
AI_MODEL=mock-model
AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=5000
AI_DAILY_USER_LIMIT=50
AI_MONTHLY_USER_LIMIT=500

ENABLE_EMAIL=true
EMAIL_PROVIDER=mock
EMAIL_FROM="test@cdsprep.local"

ENABLE_STORAGE=false
STORAGE_PROVIDER=local

ENABLE_PAYMENTS=true
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR

SEARCH_PROVIDER=postgres
CAPTCHA_PROVIDER=none
