# ==============================================================================
# CDSPrep — Production Environment Configuration Template (.env.production.example)
#
# SECURITY WARNING:
# 1. NEVER commit real secrets, API keys, or database credentials to version control.
# 2. Duplicate this file to `.env.production` on your secure production host.
# 3. Restrict filesystem permissions: chmod 600 .env.production
# ==============================================================================

# ==============================================================================
# 1. APPLICATION RUNTIME & SYSTEM
# ==============================================================================
NODE_ENV="production"
APP_PORT=3000
API_PORT=4000
TZ="UTC"

# ==============================================================================
# 2. DATABASE CONFIGURATION (POSTGRESQL & PGBOUNCER)
# ==============================================================================
# Primary connection string used by Prisma ORM.
# For high-load environments, connect via PgBouncer with `pgbouncer=true&connection_limit=25`.
DATABASE_URL="postgresql://cdsprep_admin:CHANGE_TO_SECURE_PASSWORD@postgres:5432/cdsprep?schema=public&connection_limit=25&pool_timeout=10"

# Direct connection string for Prisma CLI migrations when running behind PgBouncer:
# DIRECT_URL="postgresql://cdsprep_admin:CHANGE_TO_SECURE_PASSWORD@postgres:5432/cdsprep?schema=public"

# Database service initialization (used by docker-compose.prod.yml)
DB_USER="cdsprep_admin"
DB_PASSWORD="CHANGE_TO_CRYPTOGRAPHIC_PASSWORD_MIN_32_CHARS"
DB_NAME="cdsprep"

# ==============================================================================
# 3. REDIS STORE (CACHING, RATE LIMITING & BULLMQ WORKER QUEUES)
# ==============================================================================
# Redis URI with authentication:
REDIS_URL="redis://:CHANGE_TO_REDIS_PASSWORD@redis:6379"
REDIS_PASSWORD="CHANGE_TO_REDIS_PASSWORD"
REDIS_HOST="redis"
REDIS_PORT=6379

# ==============================================================================
# 4. AUTHENTICATION & CRYPTOGRAPHY (JSON WEB TOKENS)
# ==============================================================================
# Generate secure 256-bit keys using: openssl rand -hex 32
JWT_SECRET="CHANGE_TO_MIN_64_CHAR_HEX_SECRET_FOR_ACCESS_TOKENS"
JWT_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="CHANGE_TO_DIFFERENT_MIN_64_CHAR_HEX_SECRET_FOR_REFRESH_TOKENS"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie domain for production session management
COOKIE_DOMAIN=".cdsprep.com"
COOKIE_SECURE="true"

# ==============================================================================
# 5. OBJECT STORAGE (AWS S3 / CLOUDFLARE R2 / MINIO)
# ==============================================================================
# Storage provider for diagrams, PDFs, avatars, and question assets
S3_PROVIDER="s3" # 's3' or 'minio'
S3_ENDPOINT="https://s3.ap-south-1.amazonaws.com" # Leave empty for default AWS endpoint
S3_REGION="ap-south-1"
S3_BUCKET="cdsprep-production-assets"
S3_ACCESS_KEY="CHANGE_TO_IAM_ACCESS_KEY"
S3_SECRET_KEY="CHANGE_TO_IAM_SECRET_KEY"
S3_PUBLIC_CDN_URL="https://cdn.cdsprep.com"

# ==============================================================================
# 6. TRANSACTIONAL EMAIL PROVIDER (SMTP / AWS SES / SENDGRID)
# ==============================================================================
# Used for email verification, password reset, and exam result reports
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_SECURE="false" # false for TLS (port 587), true for SSL (port 465)
SMTP_USER="apikey"
SMTP_PASSWORD="CHANGE_TO_SENDGRID_OR_SES_API_KEY"
SMTP_FROM="CDSPrep Support <support@cdsprep.com>"

# ==============================================================================
# 7. AI PROVIDER (OPENAI / GOOGLE GEMINI)
# ==============================================================================
# Used for automated question explanations and study plan generation
AI_PROVIDER="openai" # 'openai' or 'gemini'
OPENAI_API_KEY="sk-proj-CHANGE_TO_PRODUCTION_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o-mini"

GEMINI_API_KEY="CHANGE_TO_PRODUCTION_GEMINI_API_KEY"
GEMINI_MODEL="gemini-1.5-flash"

# ==============================================================================
# 8. NETWORKING, CORS & DOMAIN TOPOLOGY
# ==============================================================================
# Wildcard CORS ('*') is strictly disallowed in production mode!
# Comma-separated list of allowed web domains:
CORS_ORIGIN="https://cdsprep.com,https://www.cdsprep.com"

# Public frontend entry point and API URL
NEXT_PUBLIC_APP_URL="https://cdsprep.com"
NEXT_PUBLIC_API_URL="https://cdsprep.com/api/v1"

# ==============================================================================
# 9. OBSERVABILITY, LOGGING & ERROR MONITORING
# ==============================================================================
LOG_LEVEL="info" # 'error', 'warn', 'info', 'debug'
SENTRY_DSN="" # Optional: Sentry error monitoring DSN
